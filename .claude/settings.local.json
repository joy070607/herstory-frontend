{
  "permissions": {
    "allow": [
      "Bash(timeout 15 npm run dev)",
      "Read(//tmp/**)",
      "Bash(rm -f pnpm-lock.yaml pnpm-workspace.yaml server.js)",
      "Bash(rm -rf app/post app/posts-rq app/providers.jsx)",
      "Bash(rm -rf node_modules .next)",
      "Bash(npm install *)",
      "Bash(npm --version)",
      "Bash(timeout 40 npm run dev)",
      "Bash(echo \"EXIT:$?\")",
      "Bash(taskkill.exe /F /PID 37376)",
      "Bash(taskkill.exe /F /PID 24024)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:3000 --max-time 3)",
      "Bash(powershell.exe -NoProfile -Command \"Get-CimInstance Win32_Process -Filter \\\\\"Name='node.exe'\\\\\" | Select-Object ProcessId,CommandLine\")",
      "Bash(powershell.exe *)",
      "Bash(git init *)",
      "Bash(git remote *)",
      "Bash(git ls-remote *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git config *)",
      "Bash(git push *)",
      "Bash(git lfs *)",
      "Bash(git-lfs version *)",
      "Bash(git fetch *)",
      "Bash(set -e)",
      "Bash(git reset *)",
      "Bash(git diff *)",
      "Bash(git --no-pager diff -- .gitignore)",
      "Bash(git update-index *)"
    ]
  }
